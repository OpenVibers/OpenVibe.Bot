{
  "id": "adeept.adr036.mecanum",
  "version": 1,
  "name": "Adeept ADR036 4WD Smart Car (mecanum)",
  "vendor": "Adeept",
  "kind": "onboard",
  "description": "The Adeept ADR036 on mecanum wheels: it drives forward/back (x), strafes left/right (y) and rotates in place, plus the same pan/tilt servos, WS2812 lights, buzzer, ultrasound, line tracking and ADS7830 battery readout as adeept.adr036.",
  "capabilities": [
    "drive.mecanum",
    "servo.pan_tilt",
    "lights.rgb",
    "speaker.horn",
    "sensor.ultrasonic",
    "sensor.line",
    "battery"
  ],
  "mapping": {
    "driver": "pca9685",
    "plugin": "adeept_adr036",
    "wheels": "mecanum",
    "i2c_bus": 1,
    "address": "0x5f",
    "motor_channels": [8, 9, 10, 11, 12, 13, 14, 15],
    "servo_channels": { "pan": 0, "tilt": 1 },
    "battery": { "driver": "ads7830", "address": "0x48" },
    "lights": "ws2812",
    "horn": "buzzer"
  },
  "commands": {
    "drive": { "axes": { "x": [-1, 1], "y": [-1, 1], "rotation": [-1, 1] } },
    "actuator": {
      "names": {
        "pan": { "type": "number", "range": [-1, 1] },
        "tilt": { "type": "number", "range": [-1, 1] },
        "buzzer": { "type": "tone", "hz": [220, 880] },
        "lights": { "type": "rgb", "count": 8 }
      }
    }
  },
  "widgets": [
    { "type": "drive", "capability": "drive.mecanum", "label": "Drive", "order": 1, "command": { "kind": "drive" } },
    { "type": "pan-tilt", "capability": "servo.pan_tilt", "label": "Pan / tilt", "order": 2, "command": { "kind": "actuator", "names": ["pan", "tilt"] } },
    { "type": "lights", "capability": "lights.rgb", "label": "Lights", "order": 3, "command": { "kind": "actuator", "names": ["lights"] } },
    { "type": "horn", "capability": "speaker.horn", "label": "Horn", "order": 4, "command": { "kind": "actuator", "names": ["buzzer"] } },
    { "type": "telemetry", "capability": "sensor.ultrasonic", "label": "Distance", "order": 5 },
    { "type": "battery", "capability": "battery", "label": "Battery", "order": 6 },
    { "type": "latency", "label": "Latency", "order": 7 }
  ],
  "camera": { "transport": "whip", "resolution": "640x480" },
  "limits": { "max_speed": 1, "max_turn": 1, "max_command_ms": 300, "heartbeat_ms": 1000 }
}
