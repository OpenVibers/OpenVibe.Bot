{
  "id": "cozmo",
  "version": 1,
  "name": "Cozmo",
  "vendor": "Anki",
  "kind": "bridge",
  "description": "Anki Cozmo over PyCozmo: differential drive, head and lift, speech, a face display (text, eyes or a picture), backpack and cube lights, cliff and pick-up sensors and a 320x240 camera. A bridge computer joins the robot's Wi-Fi on one interface and OpenVibe on another.",
  "capabilities": [
    "drive.differential",
    "head",
    "lift",
    "speaker.say",
    "display.text",
    "lights.backpack",
    "lights.cube",
    "battery",
    "sensor.cliff",
    "sensor.pickup",
    "camera"
  ],
  "mapping": {
    "driver": "cozmo",
    "plugin": "cozmo"
  },
  "commands": {
    "drive": { "axes": { "throttle": [-1, 1], "steer": [-1, 1] } },
    "actuator": {
      "names": {
        "head": { "type": "number", "range": [-1, 1] },
        "lift": { "type": "number", "range": [0, 1] },
        "backpack_lights": { "type": "rgb" },
        "cube_lights": { "type": "rgb" }
      }
    },
    "say": { "max_chars": 200 },
    "display": { "modes": ["text", "face", "image_png_b64"], "faces": ["neutral", "happy", "sad", "surprised", "sleepy", "angry"], "max_chars": 200 }
  },
  "widgets": [
    { "type": "drive", "capability": "drive.differential", "label": "Drive", "order": 1, "command": { "kind": "drive" } },
    { "type": "head", "capability": "head", "label": "Head", "order": 2, "command": { "kind": "actuator", "names": ["head"] } },
    { "type": "lift", "capability": "lift", "label": "Lift", "order": 3, "command": { "kind": "actuator", "names": ["lift"] } },
    { "type": "speaker", "capability": "speaker.say", "label": "Say", "order": 4, "command": { "kind": "say" } },
    { "type": "display", "capability": "display.text", "label": "Face", "order": 5, "command": { "kind": "display" } },
    { "type": "lights", "capability": "lights.backpack", "label": "Lights", "order": 6, "command": { "kind": "actuator", "names": ["backpack_lights", "cube_lights"] } },
    { "type": "telemetry", "capability": "sensor.cliff", "label": "Cliff / pick-up", "order": 7 },
    { "type": "battery", "capability": "battery", "label": "Battery", "order": 8 },
    { "type": "latency", "label": "Latency", "order": 9 }
  ],
  "camera": { "transport": "whip", "resolution": "320x240" },
  "limits": { "max_speed": 0.6, "max_turn": 0.8, "max_command_ms": 300, "heartbeat_ms": 1000 }
}
